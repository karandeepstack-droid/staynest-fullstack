datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Guest
  Host
  Admin
}

enum BookingStatus {
  Pending
  Confirmed
  Cancelled
  Completed
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(Guest)
  avatar    String?
  createdAt DateTime   @default(now())
  
  properties Property[]
  bookings   Booking[]
  reviews    Review[]
  wishlists  Wishlist[]
}

model Property {
  id            String          @id @default(uuid())
  hostId        String
  title         String
  description   String
  propertyType  String
  category      String          @default("Villas")
  location      String
  country       String          @default("India")
  pricePerNight Float
  cleaningFee   Float           @default(1500)
  serviceFee    Float           @default(2100)
  maxGuests     Int
  bedrooms      Int
  beds          Int
  baths         Int
  rating        Float           @default(4.9)
  reviewCount   Int             @default(0)
  isSuperhost   Boolean         @default(false)
  isApproved    Boolean         @default(true)
  createdAt     DateTime        @default(now())

  host          User            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images        PropertyImage[]
  amenities     Amenity[]
  bookings      Booking[]
  reviews       Review[]
  wishlistedBy  Wishlist[]
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  imageUrl   String

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id         String   @id @default(uuid())
  name       String
  propertyId String?

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Booking {
  id          String        @id @default(uuid())
  propertyId  String
  guestId     String
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  nights      Int
  totalPrice  Float
  status      BookingStatus @default(Confirmed)
  createdAt   DateTime      @default(now())

  property    Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest       User          @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  guestId    String
  rating     Float
  comment    String
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest      User     @relation(fields: [guestId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}
